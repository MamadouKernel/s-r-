# Modèle des valeurs de déploiement. Copier en deploy/.env (ignoré par git) et remplir. Ne jamais mettre de vraie valeur ici.
# Générer un secret : openssl rand -base64 32
POSTGRES_ADMIN_PASSWORD=
SORO_OWNER_PASSWORD=
SORO_APP_PASSWORD=
SORO_OPS_PASSWORD=
JWT_SIGNING_KEY=
PIN_PEPPER=
# Adresse du relais web dans le réseau du déploiement (fixée par compose.yml : 172.28.0.10).
WEB_PROXY_ADDRESS=172.28.0.10
# Envoi réel des e-mails (codes de vérification, rappels) : obligatoire hors développement.
SMTP_HOST=
SMTP_FROM_ADDRESS=
# SMTP_PORT=587  SMTP_SECURITY=StartTls  SMTP_USER=  SMTP_PASSWORD=
# Abonnement : prix en FCFA (nombres entiers) et numéro où les clients paient. Valeurs réelles à décider par le porteur du projet.
SUBSCRIPTION_MONTHLY_PRICE_FCFA=
SUBSCRIPTION_ANNUAL_PRICE_FCFA=
PAY_NUMBER_WAVE=
# JWT_ISSUER=soro
# JWT_AUDIENCE=soro
# WEB_PORT=8081
